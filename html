<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pandit Booking Service</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<header>
    <h1>Pandit Booking Service</h1>
    <p>शादी, गृह प्रवेश, पूजा-पाठ के लिए पंडित जी बुक करें</p>
</header>

<section class="services">
    <h2>हमारी सेवाएँ</h2>

    <div class="service-box">
        <h3>📿 गृह प्रवेश पूजा</h3>
        <p>पूरी विधि-विधान के साथ गृह प्रवेश पूजा कराई जाएगी।</p>
        <button onclick="bookPandit('गृह प्रवेश पूजा')">बुक करें</button>
    </div>

    <div class="service-box">
        <h3>💍 शादी / विवाह संस्कार</h3>
        <p>शुभ मुहूर्त देखकर संपूर्ण विवाह संस्कार।</p>
        <button onclick="bookPandit('विवाह संस्कार')">बुक करें</button>
    </div>

    <div class="service-box">
        <h3>🙏 हवन / यज्ञ</h3>
        <p>घर, दुकान या ऑफिस के लिए हवन सेवा उपलब्ध।</p>
        <button onclick="bookPandit('हवन / यज्ञ')">बुक करें</button>
    </div>

    <div class="service-box">
        <h3>⚰️ श्राद्ध / तर्पण</h3>
        <p>पूरी विधि-विधान के साथ श्राद्ध कर्म कराया जाता है।</p>
        <button onclick="bookPandit('श्राद्ध / तर्पण')">बुक करें</button>
    </div>

    <div class="service-box">
        <h3>🕉️ नामकरण संस्कार</h3>
        <p>नवजात शिशु का विधिवत नामकरण पूजा।</p>
        <button onclick="bookPandit('नामकरण संस्कार')">बुक करें</button>
    </div>

</section>

<footer>
    <p>© 2025 Pandit Booking Service — WhatsApp द्वारा बुकिंग</p>
</footer>

<script src="script.js"></script>
</body>
</html>
