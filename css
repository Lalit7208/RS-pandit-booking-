body {
    font-family: Arial, sans-serif;
    margin: 0;
    background: #f3f2f2;
    color: #333;
}

header {
    background: #ff6b00;
    color: white;
    padding: 20px;
    text-align: center;
}

.services {
    padding: 20px;
}

.service-box {
    background: white;
    padding: 15px;
    margin: 15px 0;
    border-radius: 10px;
    box-shadow: 0 0 8px #ccc;
}

.service-box h3 {
    margin-top: 0;
}

button {
    background: #28a745;
    color: white;
    padding: 10px 15px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
}

button:hover {
    background: #218838;
}

footer {
    text-align: center;
    padding: 15px;
    background: #222;
    color: white;
    margin-top: 20px;
}
